{
  "manifest_version": 3,
  "name": "Academic Evidence Highlighter",
  "description": "Review candidate evidence in scholarly search results, article pages, and PDFs.",
  "version": "0.16.3",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "Academic Evidence Highlighter",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "side_panel": {
    "default_path": "extension/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/content.js"],
      "css": ["extension/content.css"],
      "run_at": "document_idle"
    }
  ]
}
